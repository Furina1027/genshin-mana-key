<Project Sdk="Microsoft.NET.Sdk">

    <!--
        ManaKeyDumper 启动器（NativeAOT exe）。
        结构复制自 star_rail_sniffer/launcher（GPL-3.0, 源自 YaeAchievement）。
    -->

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <OutputType>WinExe</OutputType>
        <LangVersion>preview</LangVersion>
        <AssemblyName>ManaKeyDumper</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net9.0-windows</TargetFramework>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <OptimizationPreference>Size</OptimizationPreference>
    </PropertyGroup>

    <!--
        代码分析：Recommended + 警告即错误。
        启动器是"注入别人进程"的工具，路径/句柄/编码上任何一类静默错误都可能毁掉一次几小时的抓取，
        所以这里把分析器警告全部当错误处理（CA1310 文化敏感比较、CA2000 句柄未释放等就是这轮修出来的）。
    -->
    <PropertyGroup>
        <AnalysisMode>Recommended</AnalysisMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <NativeMethods Include="NativeMethods.txt" />
    </ItemGroup>

    <!-- 让 xunit 测试工程（ManaKeyDumper.Tests）能直接测 internal 的 KeyPairing / JsonStore -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>ManaKeyDumper.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
